{
  "name": "stronghold-protocol-alliance",
  "version": "0.1.1",
  "private": true,
  "description": "An unofficial fan remake of Arknights' \"Stronghold Protocol: Alliance\" as an online web game (1–4 player co-op, Node.js server + browser client)",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/vietdoan0233/Stronghold-Protocol-ENG#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vietdoan0233/Stronghold-Protocol-ENG.git"
  },
  "bugs": {
    "url": "https://github.com/vietdoan0233/Stronghold-Protocol-ENG/issues"
  },
  "keywords": [
    "arknights",
    "auto-chess",
    "tower-defense",
    "co-op",
    "browser-game",
    "fan-game"
  ],
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "vendor": "node tools/vendor.mjs",
    "build-data": "node tools/build-data.mjs",
    "assets": "node tools/vendor.mjs && node tools/fetch-assets.mjs",
    "postinstall": "node tools/vendor.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "launch": "node scripts/launch.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.2",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
